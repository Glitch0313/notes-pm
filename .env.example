# ─── قاعدة البيانات ────────────────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/notevaultpro"

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ─── Next.js ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── SMTP (البريد الإلكتروني) ─────────────────────────────────────────────────
# Gmail: host=smtp.gmail.com, port=587, secure=false
# Outlook: host=smtp.office365.com, port=587
# Mailgun / Resend: راجع وثائقهم
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="NoteVaultPro <noreply@notevaultpro.com>"

# ─── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# ─── Unsplash (صور الغلاف) ───────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"

# ─── Sentry (مراقبة الأخطاء) ─────────────────────────────────────────────────
# أنشئ مشروعاً على https://sentry.io واحصل على DSN
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
